# ─── Server ─────────────────────────────────────────────────────
PORT=4000
CAD_SERVER_URL=http://localhost:5000

# ─── Supabase ───────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Web3Auth ──────────────────────────────────────────────────
WEB3AUTH_CLIENT_ID=
WEB3AUTH_ISSUER=https://api.web3auth.io

# ─── 0G Storage (future) ───────────────────────────────────────
OG_RPC_URL=https://evmrpc-testnet.0g.ai
OG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
OG_PRIVATE_KEY=
FILE_MASTER_KEY=

# ─── 0G Compute (Mainnet) ────────────────────────────────────────
OG_API_KEY=
OG_BASE_URL=https://router-api.0g.ai/v1
OG_MODEL=0GM-1.0-35B-A3B

# ─── Groq (for testing before 0G migration) ──────────────────────
GROQ_API_KEY=

# ─── Xiaomi MiMo (provider removed — key kept for easy restore) ──
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ─── Fireworks AI ──────────────────────────────────────────────
# Models: deepseek-v4-flash, deepseek-v4-pro, minimax-m3,
#         glm-5p1, glm-5p2, qwen3p7-plus, kimi-k2p6
FIREWORKS_API_KEY=

# ─── Meta Model API (Muse Spark) ───────────────────────────────
# Contributor tier: muse-spark-1.3-contributor (prompts used to improve Meta's products)
MUSE_API_KEY=
MUSE_BASE_URL=https://api.meta.ai/v1

# ─── Streaming liveness / provider timeouts ────────────────────
# SSE comment interval that keeps proxies/browsers attached during silent thinking
SSE_HEARTBEAT_MS=15000
# undici idle ceilings for provider calls (headers = never answered, body = idle between bytes)
PROVIDER_HEADERS_TIMEOUT_MS=120000
PROVIDER_BODY_TIMEOUT_MS=1800000
# Abort a streaming generation if the provider sends no first chunk (15 min)
PROVIDER_FIRST_BYTE_TIMEOUT_MS=900000
# Abort slow non-streaming calls, e.g. the clarifier (3 min)
PROVIDER_REQUEST_TIMEOUT_MS=180000
# Independent budget for vision-FIX regenerations (separate from code retries)
MAX_VISION_FIXES=3
